{%- comment -%}
  Muro de reseñas (L08): reseñas en mampostería (columnas de CSS) con formatos mezclados: con foto,
  sólo texto y destacadas. Arriba, opcional, el promedio y una cinta que usa las mismas reseñas.
  Muestra de a tantas y un botón "Ver más". Sin reseñas cargadas no se muestra.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
  {%- render 'gad-colors', s: s, key: section.id -%}
  <div
    class="gad-rw gad-rw--h-{{ s.heading_align | default: 'center' }} gad-rw--hm-{{ s.heading_align_m | default: 'same' }} gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
    style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --rw-cols: {{ s.columns_d }}; --rw-star: {{ s.star_color }};"
    {% render 'gad-section-attrs', s: s %}
  >
    <div class="page-width">
      {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
      {%- if s.average != blank -%}
        {%- assign avg = s.average | replace: ',', '.' | times: 1.0 | round -%}
        <div class="gad-rw__summary">
          <strong class="gad-rw__avg">{{ s.average | escape }}</strong>
          <span class="gad-rw__stars" role="img" aria-label="{{ 'gadsden.reviews.stars' | t: count: s.average }}">
            {%- for i in (1..5) -%}<span{% if i > avg %} class="is-off"{% endif %}>★</span>{%- endfor -%}
          </span>
          {%- if s.count_text != blank -%}<span class="gad-rw__count">{{ s.count_text }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if s.marquee -%}
      <div class="gad-rw__marquee" aria-hidden="true">
        <div class="gad-rw__strip">
          {%- for copy in (1..2) -%}
            <div class="gad-rw__group">
              {%- for block in section.blocks limit: 12 -%}
                <span class="gad-rw__chip">
                  <span class="gad-rw__stars">{%- for i in (1..5) -%}<span{% if i > block.settings.stars %} class="is-off"{% endif %}>★</span>{%- endfor -%}</span>
                  <span>{{ block.settings.text | strip_html | truncate: 60 }}</span>
                  <b>{{ block.settings.author | escape }}</b>
                </span>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <gad-reviews-wall class="page-width{% if s.featured_title_font %} gad-rw--featured-title{% endif %}{% if s.photo_ratio != blank and s.photo_ratio != 'auto' %} gad-rw--ratio{% endif %}" data-batch="{{ s.batch }}"{% if s.photo_ratio != blank and s.photo_ratio != 'auto' %} style="--rw-ratio: {{ s.photo_ratio }};"{% endif %}>
      <div class="gad-rw__wall">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article
            class="gad-rw__card color-{% if b.featured %}{{ s.featured_scheme }}{% else %}{{ s.card_scheme }}{% endif %}{% if b.featured %} gad-rw__card--featured{% endif %}"
            {% if b.featured and s.featured_custom %}
              style="--color-background: {{ s.featured_bg.red }},{{ s.featured_bg.green }},{{ s.featured_bg.blue }}; --color-foreground: {{ s.featured_text.red }},{{ s.featured_text.green }},{{ s.featured_text.blue }}; background: {{ s.featured_bg }}; color: {{ s.featured_text }};"
            {% endif %}
            {% if forloop.index > s.batch %}
              hidden data-gad-rw-more
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', class: 'gad-rw__photo', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600' }}
            {%- endif -%}
            <div class="gad-rw__body">
              <span class="gad-rw__stars" role="img" aria-label="{{ 'gadsden.reviews.stars' | t: count: b.stars }}">
                {%- for i in (1..5) -%}<span{% if i > b.stars %} class="is-off"{% endif %}>★</span>{%- endfor -%}
              </span>
              {%- if b.title != blank -%}<h3 class="gad-rw__title">{{ b.title | escape }}</h3>{%- endif -%}
              <div class="gad-rw__text rte">{{ b.text }}</div>
              <footer class="gad-rw__foot">
                <span class="gad-rw__author">{{ b.author | escape }}</span>
                {%- if b.verified -%}
                  <span class="gad-rw__verified">{%- render 'gad-icon', name: 'verified', filled: true -%}{{ 'gadsden.reviews.verified' | t }}</span>
                {%- endif -%}
                {%- if b.date != blank -%}<span class="gad-rw__date">{{ b.date | escape }}</span>{%- endif -%}
              </footer>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > s.batch -%}
        <div class="gad-rw__more">
          {%- liquid
            assign rw_left = section.blocks.size | minus: s.batch | append: ''
            assign rw_label = s.more_label | replace: '{cantidad}', rw_left
          -%}
          <button type="button" class="button{% if s.more_style == 'solid' %} gad-title-font{% else %} button--secondary{% endif %}" data-gad-rw-btn data-label="{{ s.more_label | escape }}">{{ rw_label | escape }}</button>
        </div>
      {%- endif -%}
    </gad-reviews-wall>
  </div>
{%- elsif request.design_mode -%}
  <p class="gad-rw__empty page-width">{{ 'gadsden.reviews.empty' | t }}</p>
{%- endif -%}

{% stylesheet %}
  .gad-rw__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 1.2rem;
    margin-bottom: 2.4rem;
  }

  .gad-rw__avg {
    font-size: 3.2rem;
    line-height: 1;
  }

  .gad-rw__summary .gad-rw__stars {
    font-size: 2.2rem;
  }

  .gad-rw__count {
    font-size: 1.4rem;
    opacity: 0.8;
  }

  .gad-rw__stars {
    color: var(--rw-star, #f5b301);
    letter-spacing: 0.1rem;
  }

  .gad-rw__stars .is-off {
    opacity: 0.25;
  }

  .gad-rw__marquee {
    overflow: hidden;
    margin-bottom: 2.4rem;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .gad-rw__strip {
    display: flex;
    width: max-content;
    animation: gadRwMarquee 60s linear infinite;
  }

  .gad-rw__marquee:hover .gad-rw__strip,
  html.gad-reduce .gad-rw__strip {
    animation-play-state: paused;
  }

  .gad-rw__group {
    display: flex;
    gap: 1rem;
    padding-right: 1rem;
  }

  .gad-rw__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.4rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: 99rem;
    font-size: 1.3rem;
    white-space: nowrap;
  }

  @keyframes gadRwMarquee {
    to {
      transform: translateX(-50%);
    }
  }

  .gad-rw__wall {
    columns: 2;
    column-gap: 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .gad-rw__wall {
      columns: var(--rw-cols, 3);
      column-gap: 2rem;
    }
  }

  .gad-rw__card {
    display: inline-block;
    width: 100%;
    margin: 0 0 1.2rem;
    overflow: hidden;
    break-inside: avoid;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 1.2rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 750px) {
    .gad-rw__card {
      margin-bottom: 2rem;
    }
  }

  .gad-rw__card[hidden] {
    display: none;
  }

  .gad-rw__photo {
    display: block;
    width: 100%;
    height: auto;
  }

  .gad-rw__body {
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem;
  }

  .gad-rw__card--featured .gad-rw__text {
    font-size: 1.7rem;
    font-weight: 600;
  }

  .gad-rw__title {
    margin: 0;
    font-size: 1.5rem;
  }

  .gad-rw__text {
    font-size: 1.4rem;
  }

  .gad-rw__text p {
    margin: 0;
  }

  .gad-rw__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: 1.2rem;
  }

  .gad-rw__author {
    font-weight: 700;
  }

  .gad-rw__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    opacity: 0.8;
  }

  .gad-rw__date {
    opacity: 0.6;
  }

  .gad-rw__more {
    margin-top: 1.2rem;
    text-align: center;
  }

  .gad-rw__empty {
    padding: 1.2rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    font-size: 1.3rem;
    text-align: center;
  }
  .gad-rw--ratio .gad-rw__photo {
    aspect-ratio: var(--rw-ratio);
    object-fit: cover;
  }
  .gad-rw--h-left .gad-rw__summary {
    justify-content: flex-start;
  }

  @media screen and (max-width: 749px) {
    .gad-rw--hm-left .gad-rw__summary {
      justify-content: flex-start;
    }

    .gad-rw--hm-center .gad-rw__summary {
      justify-content: center;
    }
  }
  .gad-rw--featured-title .gad-rw__card--featured .gad-rw__text {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.5rem;
    line-height: 1.3;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% javascript %}
  class GadReviewsWall extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector('[data-gad-rw-btn]');
      if (!btn) return;
      const batch = parseInt(this.dataset.batch, 10) || 8;
      btn.addEventListener('click', () => {
        const hidden = [...this.querySelectorAll('[data-gad-rw-more][hidden]')];
        hidden.slice(0, batch).forEach((el) => (el.hidden = false));
        if (hidden.length <= batch) return btn.parentElement.remove();
        btn.textContent = (btn.dataset.label || btn.textContent).replace('{cantidad}', hidden.length - batch);
      });
    }
  }

  if (!customElements.get('gad-reviews-wall')) customElements.define('gad-reviews-wall', GadReviewsWall);
{% endjavascript %}

{% schema %}
