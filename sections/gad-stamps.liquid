{%- comment -%}
  Sellos que entran al llegar (L04): arriba un espacio para video o imagen; abajo título y sellos
  (palabra grande + línea) que entran de a uno con un golpe de sello cuando la sección aparece.
  Sin JavaScript o con "reducir movimiento" se ven todos quietos.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<gad-stamps
  class="gad-st2 gad-st2--{{ s.stamp_style | default: 'badge' }} gad-st2--words-{{ s.word_color | default: 'accent' }}{% if s.last_marker %} gad-st2--last-marker{% endif %}{% if s.media_width == 'page' %} gad-st2--media-page{% endif %} gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --st-h: {{ s.media_height }}vh; --st-rot: {{ s.angle }}deg;"
  data-delay="{{ s.delay }}"
  {% render 'gad-section-attrs', s: s %}
>
  {%- if s.media_width == 'page' -%}<div class="page-width">{%- endif -%}
  {%- if s.video != blank or s.image != blank -%}
    <div class="gad-st2__media">
      {%- if s.video != blank -%}
        {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata' }}
      {%- else -%}
        {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: s.image.alt, sizes: '100vw', widths: '750, 1200, 1800' }}
      {%- endif -%}
    </div>
  {%- elsif request.design_mode -%}
    <div class="gad-st2__media gad-st2__media--empty">{{ 'gadsden.stamps.media' | t }}</div>
  {%- endif -%}
  {%- if s.media_width == 'page' -%}</div>{%- endif -%}
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    {%- if section.blocks.size > 0 -%}
      <div class="gad-st2__row">
        {%- for block in section.blocks -%}
          <div class="gad-st2__stamp" {{ block.shopify_attributes }}>
            <b{% if s.stamp_style == 'box' %} class="gad-title-font"{% endif %}>{{ block.settings.word | escape }}</b>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if s.closing != blank -%}<p class="gad-st2__closing{% if s.closing_style == 'band' %} gad-st2__closing--band{% endif %}">{{ s.closing }}</p>{%- endif -%}
  </div>
</gad-stamps>

{% stylesheet %}
  gad-stamps {
    display: block;
    overflow-x: clip;
  }

  .gad-st2__media {
    height: var(--st-h, 50vh);
    margin: 0 0 3.2rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }

  .gad-st2__media video,
  .gad-st2__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gad-st2__media--empty {
    display: grid;
    place-items: center;
    height: 20rem;
    font-size: 1.3rem;
  }

  .gad-st2__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem;
  }

  .gad-st2__stamp {
    display: grid;
    flex: 1 1 18rem;
    max-width: 30rem;
    justify-items: center;
    gap: 0.4rem;
    padding: 1.6rem 1.2rem;
    border: 0.3rem solid rgb(var(--color-accent, var(--color-button)));
    border-radius: 0.6rem;
    text-align: center;
    transform: rotate(var(--st-rot, -3deg));
  }

  .gad-st2__stamp b {
    color: rgb(var(--color-accent, var(--color-button)));
    font-size: 3rem;
    line-height: 1;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  .gad-st2__stamp span {
    font-size: 1.4rem;
  }

  gad-stamps.is-armed .gad-st2__stamp {
    opacity: 0;
    transform: rotate(var(--st-rot, -3deg)) scale(1.8);
  }

  gad-stamps.is-armed .gad-st2__stamp.is-in {
    opacity: 1;
    transform: rotate(var(--st-rot, -3deg)) scale(1);
    transition: transform 0.28s cubic-bezier(0.3, 1.5, 0.5, 1), opacity 0.12s;
  }

  .gad-st2__closing {
    margin: 2.8rem 0 0;
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
  }

  /* video o imagen del ancho de la página, con borde */
  .gad-st2--media-page .gad-st2__media {
    border: var(--gad-skin-border, 0.2rem solid rgba(var(--color-accent, var(--color-button)), 0.45));
    border-radius: var(--media-radius, 0);
  }

  /* sellos en caja: palabra grande a la izquierda, sin inclinación */
  .gad-st2--box .gad-st2__stamp {
    --st-rot: 0deg;
  }

  .gad-st2--box .gad-st2__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .gad-st2--box .gad-st2__stamp {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    justify-items: start;
    gap: 1.2rem;
    max-width: none;
    padding: 1.6rem 1.4rem;
    border: var(--gad-skin-border, 0.1rem solid rgba(var(--color-foreground), 0.25));
    border-radius: 0.4rem;
    text-align: left;
  }

  .gad-st2--box .gad-st2__stamp b {
    font-size: 3.4rem;
    letter-spacing: 0;
  }

  @media screen and (min-width: 750px) {
    .gad-st2--box .gad-st2__row {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }

    .gad-st2--box .gad-st2__stamp {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
    }

    .gad-st2--box .gad-st2__stamp b {
      font-size: 4.4rem;
    }
  }

  .gad-st2--words-alternate .gad-st2__stamp:nth-child(even) b {
    color: rgb(var(--color-foreground));
  }

  .gad-st2--last-marker .gad-st2__stamp:last-child b {
    padding: 0 0.15em;
    background: rgb(var(--color-accent, var(--color-button)));
    color: rgb(var(--color-background));
  }

  /* remate como franja */
  .gad-st2__closing.gad-st2__closing--band {
    padding: 1.4rem 1.8rem;
    background: rgb(var(--color-accent, var(--color-button)));
    color: rgb(var(--color-background));
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.6rem;
    text-align: left;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% javascript %}
  class GadStamps extends HTMLElement {
    connectedCallback() {
      if (this._ready || (window.Gadsden && Gadsden.reduceMotion()) || (window.Shopify && Shopify.designMode)) return;
      this._ready = true;
      const stamps = [...this.querySelectorAll('.gad-st2__stamp')];
      if (!stamps.length) return;
      const delay = parseInt(this.dataset.delay, 10) || 350;
      this.classList.add('is-armed');
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        stamps.forEach((el, i) => setTimeout(() => el.classList.add('is-in'), 150 + i * delay));
      }, { threshold: 0.3 });
      io.observe(this.querySelector('.gad-st2__row'));
    }
  }

  if (!customElements.get('gad-stamps')) customElements.define('gad-stamps', GadStamps);
{% endjavascript %}

