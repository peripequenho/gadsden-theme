{%- render 'gad-section-marker', s: section.settings -%}
<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    },
    {
      "type": "header",
      "content": "Visibilidad y ancla"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Mostrar en",
      "options": [
        {
          "value": "all",
          "label": "Todos los dispositivos"
        },
        {
          "value": "mobile",
          "label": "Sólo mobile"
        },
        {
          "value": "desktop",
          "label": "Sólo desktop"
        }
      ],
      "default": "all",
      "info": "Mobile es todo lo que mide menos de 990 px."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Nombre del ancla",
      "placeholder": "beneficios",
      "info": "Para que un botón lleve hasta acá: poné como enlace del botón #beneficios (el nombre que elegiste)."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}
