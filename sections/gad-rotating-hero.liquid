      "info": "Cubre todo el fondo y le gana al degradé."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image_mobile",
      "label": "Imagen de fondo en mobile",
      "info": "Vacía: usa la de desktop."
    },
    {
      "type": "color",
      "id": "cc_text",
      "label": "Texto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno arriba",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno abajo",
      "default": 48,
      "info": "En mobile se aplica el 75 %."
    },
    {
      "type": "header",
      "content": "Visibilidad y ancla"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Mostrar en",
      "options": [
        {
          "value": "all",
          "label": "Todos los dispositivos"
        },
        {
          "value": "mobile",
          "label": "Sólo mobile"
        },
        {
          "value": "desktop",
          "label": "Sólo desktop"
        }
      ],
      "default": "all",
      "info": "Mobile es todo lo que mide menos de 990 px."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Nombre del ancla",
      "placeholder": "beneficios",
      "info": "Para que un botón lleve hasta acá: poné como enlace del botón #beneficios (el nombre que elegiste)."
    }
  ],
  "presets": [
    {
      "name": "Hero con palabra que rota"
    }
  ]
}
{% endschema %}
