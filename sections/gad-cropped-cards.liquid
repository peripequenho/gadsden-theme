{%- comment -%}
  Tarjetas con imagen recortada (L17): grilla de tarjetas con título y frase arriba a la izquierda y
  una imagen grande anclada abajo a la derecha, recortada por el borde de la tarjeta.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-cc gad-pad {% render 'gad-scheme', s: s, key: section.id %}{% if s.fit_screen %} gad-cc--fit{% endif %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --cc-cols: {{ s.columns_d }}; --cc-h: {{ s.card_height }}px; --cc-img: {{ s.image_size }}%;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
    <div class="gad-cc__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="gad-cc__card color-{{ s.card_scheme }}" {{ block.shopify_attributes }}>
          <div class="gad-cc__copy">
            <h3 class="gad-cc__title h4">{{ b.title }}</h3>
            {%- if b.text != blank -%}<p class="gad-cc__text">{{ b.text }}</p>{%- endif -%}
          </div>
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '', class: 'gad-cc__img', sizes: '(min-width: 990px) 25vw, 45vw', widths: '300, 500, 700' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .gad-cc__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .gad-cc__grid {
      grid-template-columns: repeat(var(--cc-cols, 2), minmax(0, 1fr));
      gap: 1.6rem;
    }
  }

  .gad-cc__card {
    position: relative;
    height: var(--cc-h, 260px);
    overflow: hidden;
    border-radius: 1.4rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .gad-cc--fit .gad-cc__card {
    height: min(var(--cc-h, 260px), 34svh);
  }

  .gad-cc__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.4rem;
    max-width: 75%;
    padding: 1.4rem;
  }

  @media screen and (min-width: 750px) {
    .gad-cc__copy {
      padding: 2rem;
    }
  }

  .gad-cc__title {
    margin: 0;
  }

  .gad-cc__text {
    margin: 0;
    font-size: 1.3rem;
    opacity: 0.85;
  }

  .gad-cc__img {
    position: absolute;
    right: -8%;
    bottom: -8%;
    width: var(--cc-img, 70%);
    height: auto;
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
