{%- comment -%}
  Ofertas combinadas (S17): varios productos con casillas para comprarlos juntos. Muestra el total y el
  total con el descuento elegido; el descuento real lo aplica una regla de Shopify (lo dice el editor).
  En una ficha, puede incluir el producto de la página como primero.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign keep_pct = 100 | minus: s.discount
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-bundle gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
    <gad-bundle class="gad-bundle__box" data-keep="{{ keep_pct }}" data-money-format="{{ shop.money_format | escape }}">
      <ul class="gad-bundle__list list-unstyled" role="list">
        {%- capture rows -%}
          {%- if s.include_current and product -%}
            {%- render 'gad-bundle-item', p: product, key: 'current', locked: true -%}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              {%- render 'gad-bundle-item', p: block.settings.product, key: block.id, checked: block.settings.checked, attrs: block.shopify_attributes -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if rows != blank -%}
          {{ rows }}
        {%- elsif request.design_mode -%}
          <li class="gad-bundle__empty">{{ 'gadsden.bundle.empty' | t }}</li>
        {%- endif -%}
      </ul>
      <div class="gad-bundle__summary">
        <p class="gad-bundle__total">
          <span>{{ s.total_label | escape }}</span>
          {%- if s.discount > 0 -%}<s data-gad-bundle-full></s>{%- endif -%}
          <strong data-gad-bundle-total></strong>
        </p>
        {%- if s.discount > 0 and s.discount_note != blank -%}
          {%- liquid
            assign pct = s.discount | append: ' %'
            assign note = s.discount_note | replace: '{porcentaje}', pct
          -%}
          <p class="gad-bundle__note">{{ note | escape }}</p>
        {%- endif -%}
        <button type="button" class="button button--full-width" data-gad-bundle-add>{{ s.button_label | escape }}</button>
        <p class="gad-bundle__error" role="alert" hidden></p>
      </div>
    </gad-bundle>
  </div>
</div>

{% stylesheet %}
  .gad-bundle__box {
    display: grid;
    gap: 2.4rem;
    max-width: 96rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .gad-bundle__box {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .gad-bundle__list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .gad-bundle__item {
    display: grid;
    grid-template-columns: auto 7rem minmax(0, 1fr);
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: 0.8rem;
    cursor: pointer;
  }

  .gad-bundle__item:has(input[type='checkbox']:not(:checked)) {
    opacity: 0.55;
  }

  .gad-bundle__item input {
    width: 2rem;
    height: 2rem;
    accent-color: rgb(var(--color-button));
  }

  .gad-bundle__item img,
  .gad-bundle__item svg {
    display: block;
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    border-radius: 0.4rem;
    background: rgba(var(--color-foreground), 0.04);
  }

  .gad-bundle__name {
    display: block;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .gad-bundle__price {
    font-size: 1.4rem;
  }

  .gad-bundle__price s {
    margin-right: 0.6rem;
    opacity: 0.6;
  }

  .gad-bundle__item select {
    margin-top: 0.6rem;
    max-width: 100%;
    font: inherit;
  }

  .gad-bundle__summary {
    padding: 2rem;
    border-radius: 0.8rem;
    background: rgba(var(--color-foreground), 0.05);
  }

  .gad-bundle__total {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.8rem;
    margin: 0 0 1rem;
    font-size: 1.8rem;
  }

  .gad-bundle__total s {
    opacity: 0.6;
    font-size: 1.5rem;
  }

  .gad-bundle__note {
    margin: 0 0 1.2rem;
    font-size: 1.3rem;
  }

  .gad-bundle__error {
    margin: 1rem 0 0;
    color: rgb(215, 44, 13);
    font-size: 1.3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ofertas combinadas",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Llevalos <strong>juntos</strong>",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "checkbox",
      "id": "include_current",
      "label": "En una ficha, sumar el producto de la página primero",
      "default": true
    },
    {
      "type": "range",
      "id": "discount",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Descuento a mostrar",
      "default": 10,
      "info": "Sólo cambia el total que se ve. Para cobrarlo así, creá el descuento en Shopify (por ejemplo, \"compra X y lleva Y\")."
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Texto del total",
      "default": "Total:"
    },
    {
      "type": "text",
      "id": "discount_note",
      "label": "Aviso del descuento",
      "default": "Ahorrás {porcentaje} llevándolos juntos.",
      "info": "{porcentaje}: el descuento elegido."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Agregar los elegidos"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Combinación de colores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
      "info": "Pisan a la combinación de colores elegida arriba."
    },
    {
      "type": "color",
      "id": "cc_bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cc_bg_gradient",
      "label": "Degradé de fondo",
      "info": "Si cargás un degradé, reemplaza al color de fondo."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image",
      "label": "Imagen de fondo",
      "info": "Cubre todo el fondo y le gana al degradé."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image_mobile",
      "label": "Imagen de fondo en mobile",
      "info": "Vacía: usa la de desktop."
    },
    {
      "type": "color",
      "id": "cc_text",
      "label": "Texto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno arriba",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno abajo",
      "default": 36,
      "info": "En mobile se aplica el 75 %."
    },
    {
      "type": "header",
      "content": "Visibilidad y ancla"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Mostrar en",
      "options": [
        {
          "value": "all",
          "label": "Todos los dispositivos"
        },
        {
          "value": "mobile",
          "label": "Sólo mobile"
        },
        {
          "value": "desktop",
          "label": "Sólo desktop"
        }
      ],
      "default": "all",
      "info": "Mobile es todo lo que mide menos de 990 px."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Nombre del ancla",
      "placeholder": "beneficios",
      "info": "Para que un botón lleve hasta acá: poné como enlace del botón #beneficios (el nombre que elegiste)."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "limit": 5,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "checkbox",
          "id": "checked",
          "label": "Marcado de entrada",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ofertas combinadas",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
