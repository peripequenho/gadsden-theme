{%- comment -%}
  Reseñas en dos cintas con avatares (L09): una línea con la nota y un grupo de avatares superpuestos
  que se abren al pasar el mouse; debajo, dos filas de reseñas que corren solas en sentidos opuestos
  con los bordes esfumados. Se pausan al pasar el mouse o tocar. Con "reducir movimiento" quedan
  quietas y se pueden deslizar.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-rr gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --rr-av: {{ s.avatar_size }}px; --rr-dur: {{ s.duration }}s; --rr-star: {{ s.star_color }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
    <div class="gad-rr__top">
      {%- if s.rating != blank -%}
        <span class="gad-rr__rating"><b>{{ s.rating | escape }}</b><span class="gad-rr__stars" aria-hidden="true">★★★★★</span></span>
      {%- endif -%}
      <span class="gad-rr__faces" aria-hidden="true">
        {%- for block in section.blocks limit: s.max_avatars -%}
          {%- assign b = block.settings -%}
          {%- assign face_style = '--i: ' | append: forloop.index0 -%}
          {%- if b.photo != blank -%}
            {{ b.photo | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'gad-rr__face', style: face_style }}
          {%- else -%}
            <span class="gad-rr__face gad-rr__face--{{ forloop.index | modulo: 4 }}" style="--i: {{ forloop.index0 }};">{{ b.name | slice: 0 | upcase }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if s.more_label != blank -%}<span class="gad-rr__face gad-rr__face--more" style="--i: {{ s.max_avatars }};">{{ s.more_label | escape }}</span>{%- endif -%}
      </span>
      {%- if s.subtitle != blank -%}<span class="gad-rr__sub">{{ s.subtitle }}</span>{%- endif -%}
    </div>
  </div>
  <div class="gad-rr__rows">
    {%- for row in (1..2) -%}
      <div class="gad-rr__row{% if row == 2 %} gad-rr__row--rev{% endif %}">
        <div class="gad-rr__strip">
          {%- for copy in (1..2) -%}
            <div class="gad-rr__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
              {%- for block in section.blocks -%}
                {%- liquid
                  assign in_row = 1
                  if forloop.index > half
                    assign in_row = 2
                  endif
                  if section.blocks.size < 4
                    assign in_row = row
                  endif
                -%}
                {%- if in_row == row -%}
                  {%- assign b = block.settings -%}
                  <figure class="gad-rr__card color-{{ s.card_scheme }}"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
                    <span class="gad-rr__stars" aria-label="{{ 'gadsden.reviews.stars' | t: count: b.stars }}">
                      {%- for i in (1..5) -%}<span{% if i > b.stars %} class="is-off"{% endif %}>★</span>{%- endfor -%}
                    </span>
                    <blockquote>{{ b.text }}</blockquote>
                    <figcaption>
                      {%- if b.photo != blank -%}
                        {{ b.photo | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', class: 'gad-rr__mini' }}
                      {%- else -%}
                        <span class="gad-rr__mini gad-rr__face--{{ forloop.index | modulo: 4 }}">{{ b.name | slice: 0 | upcase }}</span>
                      {%- endif -%}
                      <span><b>{{ b.name | escape }}</b>{% if b.place != blank %}<small>{{ b.place | escape }}</small>{% endif %}</span>
                    </figcaption>
                  </figure>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .gad-rr__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.6rem;
    margin-bottom: 2.8rem;
  }

  .gad-rr__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 2rem;
  }

  .gad-rr__stars {
    color: var(--rr-star, #f5b301);
    font-size: 1.4rem;
    letter-spacing: 0.1rem;
  }

  .gad-rr__stars .is-off {
    opacity: 0.25;
  }

  .gad-rr__faces {
    display: flex;
  }

  .gad-rr__face {
    display: grid;
    place-items: center;
    width: var(--rr-av, 40px);
    height: var(--rr-av, 40px);
    margin-left: calc(var(--rr-av, 40px) * -0.3);
    border: 0.2rem solid rgb(var(--color-background));
    border-radius: 50%;
    object-fit: cover;
    font-size: calc(var(--rr-av, 40px) * 0.38);
    font-weight: 700;
    transition: margin 0.25s ease, transform 0.25s ease;
    animation: gadRrIn 0.4s backwards;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  .gad-rr__face:first-child {
    margin-left: 0;
  }

  .gad-rr__faces:hover .gad-rr__face,
  .gad-rr__faces:active .gad-rr__face {
    margin-left: 0.2rem;
  }

  @keyframes gadRrIn {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  html.gad-reduce .gad-rr__face {
    animation: none;
    transition: none;
  }

  .gad-rr__face--0,
  .gad-rr__face--1,
  .gad-rr__face--2,
  .gad-rr__face--3,
  .gad-rr__face--more {
    color: rgb(var(--color-button-text));
  }

  .gad-rr__face--0 {
    background: rgb(var(--color-button));
  }

  .gad-rr__face--1 {
    background: color-mix(in srgb, rgb(var(--color-button)) 75%, #e8a33d);
  }

  .gad-rr__face--2 {
    background: color-mix(in srgb, rgb(var(--color-button)) 60%, #3daee8);
  }

  .gad-rr__face--3 {
    background: color-mix(in srgb, rgb(var(--color-button)) 60%, #e85d75);
  }

  .gad-rr__face--more {
    width: auto;
    min-width: var(--rr-av, 40px);
    padding: 0 0.8rem;
    border-radius: 99rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 1.3rem;
  }

  .gad-rr__sub {
    font-size: 1.4rem;
  }

  .gad-rr__rows {
    display: grid;
    gap: 1.2rem;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .gad-rr__row {
    overflow: hidden;
  }

  .gad-rr__strip {
    display: flex;
    width: max-content;
    animation: gadRrScroll var(--rr-dur, 50s) linear infinite;
  }

  .gad-rr__row--rev .gad-rr__strip {
    animation-direction: reverse;
  }

  .gad-rr__row:hover .gad-rr__strip,
  .gad-rr__row:active .gad-rr__strip {
    animation-play-state: paused;
  }

  html.gad-reduce .gad-rr__strip {
    animation: none;
  }

  html.gad-reduce .gad-rr__row {
    overflow-x: auto;
    scrollbar-width: none;
  }

  html.gad-reduce .gad-rr__group[aria-hidden] {
    display: none;
  }

  @keyframes gadRrScroll {
    to {
      transform: translateX(-50%);
    }
  }

  .gad-rr__group {
    display: flex;
    gap: 1.2rem;
    padding-right: 1.2rem;
  }

  .gad-rr__card {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    width: 30rem;
    margin: 0;
    padding: 1.6rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 1.2rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .gad-rr__card blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.4rem;
    font-style: normal;
  }

  .gad-rr__card blockquote p {
    margin: 0;
  }

  .gad-rr__card figcaption {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
  }

  .gad-rr__card figcaption small {
    display: block;
    opacity: 0.7;
  }

  .gad-rr__mini {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    object-fit: cover;
    color: rgb(var(--color-button-text));
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
