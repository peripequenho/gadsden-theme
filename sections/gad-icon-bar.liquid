{%- liquid
  assign s = section.settings
  assign card_key = section.id | append: '-card'
  case s.icon_size
    when 'small'
      assign icon_px = 28
    when 'large'
      assign icon_px = 56
    else
      assign icon_px = 40
  endcase
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
{%- if s.card_style == 'custom' -%}
  {%- render 'gad-colors', s: s, key: card_key, prefix: 'card_', force: true -%}
{%- endif -%}

<div
  class="gad-icon-bar gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --icon-px: {{ icon_px }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="{% unless s.full_width %}page-width{% else %}gad-icon-bar__full{% endunless %}">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}">
        {%- render 'gad-heading', title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
      </div>
    {%- endif -%}

    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="gad-icon-bar__item" {{ block.shopify_attributes }}>
          <div class="gad-icon-bar__card gad-icon-bar__card--{{ s.layout }} {% render 'gad-card-class', s: s, key: card_key %}">
            {%- if b.icon_image != blank or b.icon != blank -%}
              <span class="gad-icon-bar__icon gad-accent-{{ s.icon_color }}">
                {%- render 'gad-icon', name: b.icon, filled: b.icon_filled, image: b.icon_image, size: icon_px -%}
              </span>
            {%- endif -%}
            {%- if b.title != blank or b.text != blank -%}
              <div class="gad-icon-bar__body">
                {%- if b.title != blank -%}
                  <h3 class="gad-icon-bar__title">
                    {%- if b.link != blank -%}
                      <a href="{{ b.link }}" class="full-unstyled-link">{{ b.title }}</a>
                    {%- else -%}
                      {{ b.title }}
                    {%- endif -%}
                  </h3>
                {%- endif -%}
                {%- if b.text != blank -%}
                  <div class="gad-icon-bar__text rte">{{ b.text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      <div class="{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: 2;"{% endif %}>
        {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gad-icon-bar__full {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .gad-icon-bar__full {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }

  .gad-icon-bar__item {
    display: flex;
    min-width: 0;
    container-type: inline-size;
  }

  /* Caja angosta (dos por fila en mobile): el ícono va arriba del texto para que no se pisen. */
  @container (max-width: 24rem) {
    .gad-icon-bar__item .gad-icon-bar__card--horizontal {
      flex-direction: column;
      text-align: center;
    }

    .gad-icon-bar__item .gad-icon-bar__card.gad-card--box {
      padding: 1.6rem 1.2rem;
    }
  }

  .gad-icon-bar__card {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    text-align: center;
  }

  .gad-icon-bar__card.gad-card--box {
    padding: 2.4rem 2rem;
    border-radius: var(--text-boxes-radius);
  }

  .gad-icon-bar__card--horizontal {
    flex-direction: row;
    align-items: center;
    text-align: left;
  }

  .gad-icon-bar__icon {
    display: inline-flex;
    font-size: var(--icon-px);
    line-height: 1;
  }

  .gad-icon-bar__icon .gad-icon {
    font-size: var(--icon-px);
  }

  .gad-icon-bar__title {
    margin: 0;
    word-break: normal;
    overflow-wrap: break-word;
    hyphens: auto;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .gad-icon-bar__text {
    margin-top: 0.4rem;
    font-size: 1.4rem;
  }

  .gad-icon-bar__text p {
    margin: 0;
  }
{% endstylesheet %}

