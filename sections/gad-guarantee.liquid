{%- comment -%}
  Garantía con anillo (L14): un anillo que se llena al aparecer y un número que cuenta hasta los días
  de garantía, al lado del titular con un chip; debajo texto, tres puntos con ícono y un botón.
  Con "reducir movimiento" el anillo y el número aparecen completos.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign r = 54
  assign circ = 339.29
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<gad-guarantee
  class="gad-gr gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --gr-size: {{ s.ring_size }}px; --gr-shift: {{ s.ring_offset }};{% if s.ring_color != blank %} --gr-c: {{ s.ring_color }};{% endif %}{% if s.ring_track != blank %} --gr-t: {{ s.ring_track }};{% endif %}"
  data-days="{{ s.days }}"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    <div class="gad-gr__top">
      <div class="gad-gr__ring" role="img" aria-label="{{ s.days }} {{ s.caption | escape }}">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle class="gad-gr__track" cx="60" cy="60" r="{{ r }}"/>
          <circle class="gad-gr__arc" cx="60" cy="60" r="{{ r }}" stroke-dasharray="{{ circ }}" stroke-dashoffset="0"/>
        </svg>
        <span class="gad-gr__num"><b data-gad-gr-num>{{ s.days }}</b>{%- if s.caption != blank -%}<small>{{ s.caption | escape }}</small>{%- endif -%}</span>
      </div>
      <div class="gad-gr__head">
        {%- render 'gad-heading', title: s.heading, size: s.heading_size, accent: s.heading_accent -%}
        {%- if s.chip != blank -%}<span class="gad-gr__chip">{{ s.chip }}</span>{%- endif -%}
      </div>
    </div>
    {%- if s.text != blank -%}<div class="gad-gr__text rte">{{ s.text }}</div>{%- endif -%}
    <ul class="gad-gr__points list-unstyled" role="list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign k = 'point_' | append: i
          assign ki = 'point_' | append: i | append: '_icon'
        -%}
        {%- if s[k] != blank -%}
          <li>{%- render 'gad-icon', name: s[ki], filled: true -%}<span>{{ s[k] }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_link | default: '#oferta' }}" class="button gad-gr__btn">{{ s.button_label | escape }}</a>
    {%- endif -%}
  </div>
</gad-guarantee>

{% stylesheet %}
  gad-guarantee {
    display: block;
    overflow-x: clip;
  }

  .gad-gr__top {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .gad-gr__ring {
    position: relative;
    flex: 0 0 auto;
    width: var(--gr-size, 160px);
    height: var(--gr-size, 160px);
    margin-left: calc(var(--gr-size, 160px) * var(--gr-shift, 0) / -100);
  }

  .gad-gr__ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .gad-gr__track,
  .gad-gr__arc {
    fill: none;
    stroke-width: 10;
  }

  .gad-gr__track {
    stroke: var(--gr-t, rgba(var(--color-foreground), 0.1));
  }

  .gad-gr__arc {
    stroke: var(--gr-c, rgb(var(--color-button)));
    stroke-linecap: round;
  }

  .gad-gr__num {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    line-height: 1;
  }

  .gad-gr__num b {
    font-size: calc(var(--gr-size, 160px) * 0.32);
    color: rgb(var(--color-foreground));
    font-variant-numeric: tabular-nums;
  }

  .gad-gr__num small {
    margin-top: 0.4rem;
    font-size: 1.2rem;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  .gad-gr__head .gad-heading {
    margin: 0;
    text-align: left;
  }

  .gad-gr__chip {
    display: inline-block;
    margin-top: 0.8rem;
    padding: 0.4rem 1.2rem;
    border-radius: 99rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 1.3rem;
    font-weight: 700;
  }

  .gad-gr__text {
    margin-top: 2rem;
  }

  .gad-gr__points {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
  }

  .gad-gr__points li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .gad-gr__points .gad-icon {
    font-size: 2.4rem;
  }

  @media screen and (max-width: 749px) {
    .gad-gr__btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  class GadGuarantee extends HTMLElement {
    connectedCallback() {
      if (this._ready || (window.Gadsden && Gadsden.reduceMotion())) return;
      this._ready = true;
      const arc = this.querySelector('.gad-gr__arc');
      const num = this.querySelector('[data-gad-gr-num]');
      const days = parseInt(this.dataset.days, 10) || 0;
      const circ = parseFloat(arc.getAttribute('stroke-dasharray'));
      arc.style.strokeDashoffset = circ;
      num.textContent = '0';
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const dur = 1400;
        const tick = (now) => {
          const t = Math.min(1, (now - start) / dur);
          const e = 1 - Math.pow(1 - t, 3);
          arc.style.strokeDashoffset = circ * (1 - e);
          num.textContent = String(Math.round(days * e));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, { threshold: 0.4 });
      io.observe(this);
    }
  }

  if (!customElements.get('gad-guarantee')) customElements.define('gad-guarantee', GadGuarantee);
{% endjavascript %}

