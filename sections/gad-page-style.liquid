{%- comment -%}
  Estilo de esta página (L19): sección invisible que cambia el aspecto sólo de la página donde está:
  colores de la combinación 1, fuente y forma de los títulos, botón de compra, borde de las fotos de la
  ficha y colores de la barra de anuncios. Borrarla vuelve todo atrás.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- style -%}
  {%- if s.title_font_on -%}
    {{ s.title_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if s.colors_on -%}
    :root, body, .color-scheme-1 {
      --color-background: {{ s.bg.red }},{{ s.bg.green }},{{ s.bg.blue }};
      --gradient-background: {{ s.bg }};
      --color-foreground: {{ s.text.red }},{{ s.text.green }},{{ s.text.blue }};
      --color-button: {{ s.button.red }},{{ s.button.green }},{{ s.button.blue }};
      --color-button-text: {{ s.button_text.red }},{{ s.button_text.green }},{{ s.button_text.blue }};
      --color-secondary-button-text: {{ s.button.red }},{{ s.button.green }},{{ s.button.blue }};
      --color-link: {{ s.button.red }},{{ s.button.green }},{{ s.button.blue }};
    }
    body {
      background-color: {{ s.bg }};
    }
  {%- endif -%}
  {%- if s.title_font_on -%}
    :root {
      --font-heading-family: {{ s.title_font.family }}, {{ s.title_font.fallback_families }};
      --font-heading-style: {{ s.title_font.style }};
      --font-heading-weight: {{ s.title_font.weight }};
    }
  {%- endif -%}
  {%- if s.title_case != 'none' or s.title_skew != 0 or s.title_italic -%}
    #MainContent :is(h1, h2, h3, .h0, .h1, .h2, .gad-heading__title) {
      {%- if s.title_case != 'none' -%}text-transform: {{ s.title_case }};{%- endif -%}
      {%- if s.title_italic -%}font-style: italic;{%- endif -%}
      {%- if s.title_skew != 0 -%}transform: skewX({{ s.title_skew }}deg); transform-origin: left center;{%- endif -%}
    }
  {%- endif -%}
  {%- if s.atc_on -%}
    .product-form__submit, .gad-atc__btn, [data-gad-bundle-add] {
      {%- if s.atc_bg != blank -%}--color-button: {{ s.atc_bg.red }},{{ s.atc_bg.green }},{{ s.atc_bg.blue }};{%- endif -%}
      {%- if s.atc_text != blank -%}--color-button-text: {{ s.atc_text.red }},{{ s.atc_text.green }},{{ s.atc_text.blue }};{%- endif -%}
      border-radius: {{ s.atc_radius }}px;
      {%- if s.atc_skew != 0 -%}transform: skewX({{ s.atc_skew }}deg);{%- endif -%}
      {%- if s.atc_upper -%}text-transform: uppercase; letter-spacing: 0.08rem;{%- endif -%}
    }
    .product-form__submit::after, .gad-atc__btn::after, [data-gad-bundle-add]::after {
      border-radius: {{ s.atc_radius }}px;
    }
  {%- endif -%}
  {%- if s.media_border > 0 -%}
    .product__media-item .product-media-container {
      border: {{ s.media_border }}px solid {{ s.media_border_color | default: 'currentColor' }};
    }
  {%- endif -%}
  {%- if s.bar_on -%}
    .announcement-bar-section .utility-bar, .announcement-bar-section .announcement-bar, .announcement-bar-section [class*='color-'] {
      background: {{ s.bar_bg }};
      --color-foreground: {{ s.bar_text.red }},{{ s.bar_text.green }},{{ s.bar_text.blue }};
      --gradient-background: {{ s.bar_bg }};
      color: {{ s.bar_text }};
    }
  {%- endif -%}
{%- endstyle -%}
{%- if request.design_mode -%}
  <p class="gad-ps-note page-width" {% render 'gad-section-attrs', s: s %}>{{ 'gadsden.page_style.note' | t }}</p>
{%- endif -%}

{% stylesheet %}
  .gad-ps-note {
    margin: 1rem auto;
    padding: 1rem 1.5rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    font-size: 1.3rem;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Estilo de esta página",
  "tag": "section",
  "class": "gad-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "No se ve: cambia el aspecto sólo de la página donde la agregás. Borrala para volver al estilo de la tienda."
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "checkbox",
      "id": "colors_on",
      "label": "Cambiar los colores principales",
      "default": false,
      "info": "Pisa la combinación 1, la que usan casi todas las secciones."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo",
      "default": "#F2EEE6"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Texto",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "button",
      "label": "Botones",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Texto de los botones",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Títulos"
    },
    {
      "type": "checkbox",
      "id": "title_font_on",
      "label": "Usar otra fuente para los títulos",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Fuente de los títulos",
      "default": "assistant_n4"
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "Mayúsculas",
      "options": [
        {
          "value": "none",
          "label": "Como están escritos"
        },
        {
          "value": "uppercase",
          "label": "Todo en mayúsculas"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "title_italic",
      "label": "Cursiva",
      "default": false
    },
    {
      "type": "range",
      "id": "title_skew",
      "min": -12,
      "max": 0,
      "step": 1,
      "unit": "°",
      "label": "Inclinación",
      "default": 0
    },
    {
      "type": "header",
      "content": "Botón de compra"
    },
    {
      "type": "checkbox",
      "id": "atc_on",
      "label": "Cambiar el botón de compra",
      "default": false,
      "info": "El de la ficha y los de agregar al carrito de las secciones."
    },
    {
      "type": "color",
      "id": "atc_bg",
      "label": "Fondo"
    },
    {
      "type": "color",
      "id": "atc_text",
      "label": "Texto"
    },
    {
      "type": "range",
      "id": "atc_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Redondeo",
      "default": 0
    },
    {
      "type": "range",
      "id": "atc_skew",
      "min": -12,
      "max": 0,
      "step": 1,
      "unit": "°",
      "label": "Inclinación",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "atc_upper",
      "label": "Mayúsculas",
      "default": false
    },
    {
      "type": "header",
      "content": "Fotos de la ficha"
    },
    {
      "type": "range",
      "id": "media_border",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Borde",
      "default": 0
    },
    {
      "type": "color",
      "id": "media_border_color",
      "label": "Color del borde",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "header",
      "content": "Barra de anuncios"
    },
    {
      "type": "checkbox",
      "id": "bar_on",
      "label": "Cambiar los colores de la barra",
      "default": false
    },
    {
      "type": "color",
      "id": "bar_bg",
      "label": "Fondo",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "bar_text",
      "label": "Texto",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Estilo de esta página"
    }
  ]
}
{% endschema %}
