        },
        {
          "type": "text",
          "id": "handle",
          "label": "Usuario",
          "default": "@cliente"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Tilde de verificado",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto de la publicación"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Me encantó, llegó rapidísimo.</p>"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Me gusta",
          "default": "128"
        },
        {
          "type": "text",
          "id": "comments",
