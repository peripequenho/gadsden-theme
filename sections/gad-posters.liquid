{%- comment -%}
  Pósters con rótulo (L03): tarjetas con imagen de fondo y el texto encima (volanta, título, línea y
  chapitas "nombre | dato"). En mobile, carrusel con puntos; en desktop, una fila de columnas.
  Al final, opcionales, un desplegable con una lista larga y un sello de cierre.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-po gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --po-ratio: {{ s.ratio }}; --po-ov: {{ s.overlay | divided_by: 100.0 }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="gad-po__card gad-po__card--{{ s.text_position }}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: b.image.alt, class: 'gad-po__bg', sizes: '(min-width: 990px) 33vw, 85vw', widths: '400, 600, 900' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'gad-po__bg gad-po__ph' }}
          {%- endif -%}
          <div class="gad-po__label">
            {%- if b.kicker != blank -%}<span class="gad-po__kicker">{{ b.kicker | escape }}</span>{%- endif -%}
            {%- if b.title != blank -%}<h3 class="gad-po__title h3">{{ b.title }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="gad-po__text">{{ b.text }}</p>{%- endif -%}
            {%- if b.chips != blank -%}
              <ul class="gad-po__chips list-unstyled" role="list">
                {%- assign rows = b.chips | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign row = row | strip -%}
                  {%- if row != blank -%}
                    {%- assign parts = row | split: '|' -%}
                    <li>{{ parts[0] | strip | escape }}{% if parts[1] %} <b>{{ parts[1] | strip | escape }}</b>{% endif %}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if section.blocks.size > 0 -%}
      {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading, force_d_on: false, force_m_on: true, d_per_view: s.columns_d, m_per_view: 1, gap_d: 20, gap_m: 12 -%}
    {%- endif -%}
    {%- if s.list_title != blank and s.list_content != blank -%}
      <details class="gad-po__list">
        <summary>{{ s.list_title | escape }}{%- render 'gad-icon', name: 'expand_more' -%}</summary>
        <div class="rte">{{ s.list_content }}</div>
      </details>
    {%- endif -%}
    {%- if s.seal_text != blank -%}
      <p class="gad-po__seal"><span>{{ s.seal_text | escape }}</span>{%- if s.seal_value != blank -%}<b>{{ s.seal_value | escape }}</b>{%- endif -%}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gad-po__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: var(--po-ratio, 3 / 4);
    overflow: hidden;
    border-radius: 1.2rem;
    background: #1a1a1a;
    color: #fff;
    isolation: isolate;
  }

  .gad-po__card--top {
    justify-content: flex-start;
  }

  .gad-po__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gad-po__ph {
    background: #2a2a2a;
    opacity: 0.6;
  }

  .gad-po__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 0, 0, calc(var(--po-ov) + 0.35)), rgba(0, 0, 0, var(--po-ov)) 55%, transparent);
  }

  .gad-po__card--top::before {
    background: linear-gradient(to bottom, rgba(0, 0, 0, calc(var(--po-ov) + 0.35)), rgba(0, 0, 0, var(--po-ov)) 55%, transparent);
  }

  .gad-po__label {
    display: grid;
    gap: 0.6rem;
    padding: 2rem;
  }

  .gad-po__kicker {
    color: rgb(var(--color-accent, var(--color-button)));
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
  }

  .gad-po .gad-po__title {
    margin: 0;
    color: #fff;
  }

  .gad-po__text {
    margin: 0;
    font-size: 1.4rem;
    opacity: 0.9;
  }

  .gad-po__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
  }

  .gad-po__chips li {
    padding: 0.2rem 0.8rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.35);
    border-radius: 99rem;
    font-size: 1.2rem;
  }

  .gad-po__list {
    max-width: 72rem;
    margin: 3.2rem auto 0;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .gad-po__list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4rem 0;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .gad-po__list summary::-webkit-details-marker {
    display: none;
  }

  .gad-po__list[open] summary .gad-icon {
    transform: rotate(180deg);
  }

  .gad-po__list .rte {
    padding-bottom: 1.6rem;
  }

  .gad-po__seal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin: 2.4rem 0 0;
    font-size: 1.3rem;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pósters con texto",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Volanta",
      "info": "Texto chico arriba del título. Vacío: no se muestra."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la volanta",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Pensado para <strong>tu día</strong>",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Forma",
      "options": [
        {
          "value": "3 / 4",
          "label": "Vertical 3:4"
        },
        {
          "value": "4 / 5",
          "label": "Vertical 4:5"
        },
        {
          "value": "1 / 1",
          "label": "Cuadrada"
        }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "columns_d",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columnas en desktop",
      "default": 3,
      "info": "En mobile se deslizan de a una."
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Oscurecer la imagen",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Texto",
      "options": [
        {
          "value": "bottom",
          "label": "Abajo"
        },
        {
          "value": "top",
          "label": "Arriba"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Lista desplegable y sello"
    },
    {
      "type": "text",
      "id": "list_title",
      "label": "Título del desplegable",
      "info": "Vacío: sin desplegable."
    },
    {
      "type": "richtext",
      "id": "list_content",
      "label": "Contenido del desplegable"
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Sello de cierre",
      "info": "Ej. Todo declarado."
    },
    {
      "type": "text",
      "id": "seal_value",
      "label": "Dato del sello"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Combinación de colores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
      "info": "Pisan a la combinación de colores elegida arriba."
    },
    {
      "type": "color",
      "id": "cc_bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cc_bg_gradient",
      "label": "Degradé de fondo",
      "info": "Si cargás un degradé, reemplaza al color de fondo."
    },
    {
      "type": "image_picker",
