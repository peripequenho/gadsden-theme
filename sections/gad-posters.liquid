{%- comment -%}
  Pósters con rótulo (L03): tarjetas con imagen de fondo y el texto encima (volanta, título, línea y
  chapitas "nombre | dato"). En mobile, carrusel con puntos; en desktop, una fila de columnas.
  Al final, opcionales, un desplegable con una lista larga y un sello de cierre.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-po{% if s.height_d > 0 %} gad-po--fixed-h{% endif %} gad-po--chips-{{ s.chips_style | default: 'pills' }}{% if s.first_wide %} gad-po--first-wide{% endif %}{% if s.title_accent %} gad-po--title-accent{% endif %} gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --po-ratio: {{ s.ratio }}; --po-ov: {{ s.overlay | divided_by: 100.0 }};{% if s.height_d > 0 %} --po-h: {{ s.height_d }}px;{% endif %}"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="gad-po__card gad-po__card--{{ s.text_position }}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: b.image.alt, class: 'gad-po__bg', sizes: '(min-width: 990px) 33vw, 85vw', widths: '400, 600, 900' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'gad-po__bg gad-po__ph' }}
          {%- endif -%}
          <div class="gad-po__label">
            {%- if b.kicker != blank -%}<span class="gad-po__kicker">{{ b.kicker | escape }}</span>{%- endif -%}
            {%- if b.title != blank -%}<h3 class="gad-po__title h3{% if s.title_accent %} gad-title-font{% endif %}">{{ b.title }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="gad-po__text">{{ b.text }}</p>{%- endif -%}
            {%- if b.chips != blank -%}
              <ul class="gad-po__chips list-unstyled" role="list">
                {%- assign rows = b.chips | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign row = row | strip -%}
                  {%- if row != blank -%}
                    {%- assign parts = row | split: '|' -%}
                    <li>{{ parts[0] | strip | escape }}{% if parts[1] %} <b>{{ parts[1] | strip | escape }}</b>{% endif %}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if section.blocks.size > 0 -%}
      {%- liquid
        assign po_cols = s.columns_d
        if s.first_wide
          assign po_cols = s.columns_d | plus: 1
        endif
      -%}
      {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading, force_d_on: false, force_m_on: true, d_per_view: po_cols, m_per_view: 1, gap_d: 20, gap_m: 12 -%}
    {%- endif -%}
    {%- if s.list_title != blank and s.list_content != blank -%}
      <details class="gad-po__list{% if s.list_style == 'box' %} gad-po__list--box{% endif %}">
        <summary>{{ s.list_title | escape }}{%- render 'gad-icon', name: 'expand_more' -%}</summary>
        <div class="rte">{{ s.list_content }}</div>
      </details>
    {%- endif -%}
    {%- if s.seal_text != blank -%}
      <p class="gad-po__seal{% if s.seal_style == 'band' %} gad-po__seal--band{% endif %}"><span>{{ s.seal_text | escape }}</span>{%- if s.seal_value != blank -%}<b>{{ s.seal_value | escape }}</b>{%- endif -%}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gad-po__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: var(--po-ratio, 3 / 4);
    overflow: hidden;
    border-radius: 1.2rem;
    background: #1a1a1a;
    color: #fff;
    isolation: isolate;
  }

  .gad-po__card--top {
    justify-content: flex-start;
  }

  .gad-po__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gad-po__ph {
    background: #2a2a2a;
    opacity: 0.6;
  }

  .gad-po__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 0, 0, calc(var(--po-ov) + 0.35)), rgba(0, 0, 0, var(--po-ov)) 55%, transparent);
  }

  .gad-po__card--top::before {
    background: linear-gradient(to bottom, rgba(0, 0, 0, calc(var(--po-ov) + 0.35)), rgba(0, 0, 0, var(--po-ov)) 55%, transparent);
  }

  .gad-po__label {
    display: grid;
    gap: 0.6rem;
    padding: 2rem;
  }

  .gad-po__kicker {
    color: rgb(var(--color-accent, var(--color-button)));
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
  }

  .gad-po .gad-po__title {
    margin: 0;
    color: #fff;
  }

  .gad-po__text {
    margin: 0;
    font-size: 1.4rem;
    opacity: 0.9;
  }

  .gad-po__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
  }

  .gad-po__chips li {
    padding: 0.2rem 0.8rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.35);
    border-radius: 99rem;
    font-size: 1.2rem;
  }

  .gad-po__list {
    max-width: 72rem;
    margin: 3.2rem auto 0;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .gad-po__list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4rem 0;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .gad-po__list summary::-webkit-details-marker {
    display: none;
  }

  .gad-po__list[open] summary .gad-icon {
    transform: rotate(180deg);
  }

  .gad-po__list .rte {
    padding-bottom: 1.6rem;
  }

  .gad-po__seal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin: 2.4rem 0 0;
    font-size: 1.3rem;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
  }
  .gad-po.gad-po--title-accent .gad-po__title {
    color: rgb(var(--color-accent, var(--color-button)));
  }

  /* primer póster más ancho (desktop sin carrusel): ocupa el lugar de dos */
  @media screen and (min-width: 750px) {
    :where(html[data-gad-bp='750']) .gad-po--first-wide gad-carousel:not(.gad-carousel--d-on) .gad-carousel__track > :first-child {
      flex-basis: calc((100% - var(--gap) * (var(--pv) - 1)) / var(--pv) * 2 + var(--gap));
      aspect-ratio: auto;
    }
  }

  @media screen and (min-width: 990px) {
    :where(html:not([data-gad-bp='750'])) .gad-po--first-wide gad-carousel:not(.gad-carousel--d-on) .gad-carousel__track > :first-child {
      flex-basis: calc((100% - var(--gap) * (var(--pv) - 1)) / var(--pv) * 2 + var(--gap));
      aspect-ratio: auto;
    }
  }

  /* datos como filas */
  .gad-po--chips-rows .gad-po__chips {
    display: grid;
    gap: 0.4rem;
  }

  .gad-po--chips-rows .gad-po__chips li {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gad-po--chips-rows .gad-po__chips b {
    color: rgb(var(--color-accent, var(--color-button)));
  }

  /* desplegable en caja */
  .gad-po__list.gad-po__list--box {
    max-width: none;
    padding: 0 1.6rem;
    border: var(--gad-skin-border, 0.2rem solid rgba(var(--color-foreground), 0.25));
  }

  .gad-po__list--box summary {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* sello como franja */
  .gad-po__seal.gad-po__seal--band {
    justify-content: space-between;
    margin-top: 1.2rem;
    padding: 1.2rem 1.6rem;
    background: rgb(var(--color-accent, var(--color-button)));
    color: rgb(var(--color-background));
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }
  @media screen and (min-width: 990px) {
    .gad-po--fixed-h .gad-po__card {
      height: var(--po-h);
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pósters con texto",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Volanta",
      "info": "Texto chico arriba del título. Vacío: no se muestra."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la volanta",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Pensado para <strong>tu día</strong>",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del encabezado",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "info": "Volanta, título y texto de arriba."
    },
    {
      "type": "select",
      "id": "heading_align_m",
      "label": "Alineación del encabezado en mobile",
      "default": "same",
      "options": [
        {
          "value": "same",
          "label": "Igual que en desktop"
        },
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Forma",
      "options": [
        {
          "value": "3 / 4",
          "label": "Vertical 3:4"
        },
        {
          "value": "4 / 5",
          "label": "Vertical 4:5"
        },
        {
          "value": "1 / 1",
          "label": "Cuadrada"
        }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "height_d",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Alto fijo en desktop",
      "default": 0,
      "info": "0: según la proporción. Con alto fijo, el ancho sale de las columnas."
    },
    {
      "type": "range",
      "id": "m_peek",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vista previa del siguiente en mobile",
      "default": 0
    },
    {
      "type": "range",
      "id": "columns_d",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columnas en desktop",
      "default": 3,
      "info": "En mobile se deslizan de a una."
    },
    {
      "type": "checkbox",
      "id": "first_wide",
      "label": "Primer póster más ancho en desktop",
      "default": false,
      "info": "Ocupa el lugar de dos."
    },
    {
      "type": "checkbox",
      "id": "title_accent",
