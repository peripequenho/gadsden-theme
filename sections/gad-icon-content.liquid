{%- comment -%}
  Íconos con contenido (S21). Dos disposiciones:
  - Grilla: ícono, título y texto por ítem; los bloques Título, Texto y Botón van arriba de la grilla.
  - Dos columnas: en una va la lista de ítems (ícono chico al lado del título y el texto abajo) y en la otra la
    columna de contenido armada con los bloques Título, Texto y Botón. Se elige qué columna va primero en desktop
    y en mobile, y la alineación del contenido (en mobile siempre va centrado).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign is_cols = false -%}
{%- if s.layout == 'columns' -%}{%- assign is_cols = true -%}{%- endif -%}
{%- capture content -%}
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        {%- if b.caption != blank -%}
          <p class="gad-heading__caption caption-with-letter-spacing caption-with-letter-spacing--medium"{% if b.caption_color != blank %} style="color: {{ b.caption_color }};"{% endif %} {{ block.shopify_attributes }}>
            {{- b.caption | escape -}}
          </p>
        {%- endif -%}
        {%- if b.title != blank -%}
          <h2 class="gad-icc__heading gad-hl inline-richtext {{ b.heading_size }}"{% if b.heading_accent != blank %} style="--gad-hl: {{ b.heading_accent }};"{% endif %} {{ block.shopify_attributes }}>
            {{- b.title -}}
          </h2>
        {%- endif -%}
      {%- when 'text' -%}
        {%- if b.text != blank -%}<div class="gad-icc__text rte" {{ block.shopify_attributes }}>{{ b.text }}</div>{%- endif -%}
      {%- when 'button' -%}
        {%- if b.button_label != blank -%}
          <a href="{{ b.button_link | default: '#' }}" class="button{% if b.button_secondary %} button--secondary{% endif %}" {{ block.shopify_attributes }}>
            {{- b.button_label | escape -}}
          </a>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-ic gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --ic-d: {{ s.columns_d }}; --ic-m: {{ s.columns_m }}; --ic-size: {{ s.icon_size }}px;{% if s.icon_custom_color != blank %} --gad-icon-color: {{ s.icon_custom_color }};{% endif %}"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
    {%- if is_cols -%}
      <div class="gad-icc{% if s.content_first_d %} gad-icc--d-content-first{% endif %}{% if s.content_first_m %} gad-icc--m-content-first{% endif %}">
        <div class="gad-icc__items gad-icc__items--{{ s.item_align }} gad-icc__items--icon-{{ s.row_icon_size }} gad-icc__items--title-{{ s.row_title_size }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'item' -%}
              {%- assign b = block.settings -%}
              <div class="gad-icc__item" {{ block.shopify_attributes }}>
                <h3 class="gad-icc__item-title {{ s.row_title_size }}">
                  <span class="gad-icc__item-icon{% if s.icon_custom_color == blank %} gad-accent-{{ s.icon_color }}{% endif %}">
                    {%- render 'gad-icon', name: b.icon, filled: b.icon_filled, image: b.icon_image -%}
                  </span>
                  {%- if b.title != blank -%}<span>{{ b.title }}</span>{%- endif -%}
                </h3>
                {%- if b.text != blank -%}<div class="gad-icc__item-text rte">{{ b.text }}</div>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if content != blank -%}
          <div class="gad-icc__content gad-icc__content--{{ s.content_align }}{% if s.hide_content_m %} gad-icc__content--hide-m{% endif %}">
            {{- content -}}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- if content != blank -%}
        <div class="gad-icc__content gad-icc__content--{{ s.content_align }} gad-icc__content--above{% if s.hide_content_m %} gad-icc__content--hide-m{% endif %}">
          {{- content -}}
        </div>
      {%- endif -%}
      <div class="gad-ic__grid gad-ic__grid--{{ s.align }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            {%- assign b = block.settings -%}
            <div class="gad-ic__item" {{ block.shopify_attributes }}>
              <span class="gad-ic__icon{% if s.icon_custom_color == blank %} gad-accent-{{ s.icon_color }}{% endif %}">
                {%- render 'gad-icon', name: b.icon, filled: b.icon_filled, image: b.icon_image, size: s.icon_size -%}
              </span>
              {%- if b.title != blank -%}<h3 class="gad-ic__title h4">{{ b.title }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<div class="gad-ic__text rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.video != blank -%}
                <div class="gad-ic__media">{%- render 'gad-video', video: b.video, poster: b.image, autoplay: true, loop: true, tap: true -%}</div>
              {%- elsif b.image != blank -%}
                <div class="gad-ic__media">{{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 990px) 30vw, 90vw', widths: '300, 500, 800' }}</div>
              {%- endif -%}
              {%- if b.button_label != blank or b.button_label_2 != blank -%}
                <div class="gad-ic__buttons">
                  {%- if b.button_label != blank -%}<a href="{{ b.button_link | default: '#' }}" class="button">{{ b.button_label | escape }}</a>{%- endif -%}
                  {%- if b.button_label_2 != blank -%}<a href="{{ b.button_link_2 | default: '#' }}" class="button button--secondary">{{ b.button_label_2 | escape }}</a>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gad-ic__grid {
    display: grid;
    grid-template-columns: repeat(var(--ic-m, 1), minmax(0, 1fr));
    gap: 3.2rem 2.4rem;
  }

  @media screen and (min-width: 750px) {
    .gad-ic__grid {
      grid-template-columns: repeat(var(--ic-d, 3), minmax(0, 1fr));
    }
  }

  .gad-ic__item {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .gad-ic__grid--center .gad-ic__item {
    align-items: center;
    text-align: center;
  }

  .gad-ic__icon {
    display: grid;
    place-items: center;
    width: calc(var(--ic-size, 56px) * 1.6);
    height: calc(var(--ic-size, 56px) * 1.6);
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.06);
  }

  .gad-ic__icon .gad-icon--image img {
    width: var(--ic-size, 56px);
    height: var(--ic-size, 56px);
    object-fit: contain;
  }

  .gad-ic__title {
    margin: 0;
  }

  .gad-ic__text p {
    margin: 0;
  }

  .gad-ic__media img,
  .gad-ic__media gad-video {
    display: block;
    width: 100%;
    border-radius: 0.8rem;
    overflow: hidden;
  }

  .gad-ic__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Contenido (bloques Título, Texto y Botón) */
  .gad-icc__content {
    text-align: center;
  }

  .gad-icc__content > * {
    margin-top: 2rem;
    margin-bottom: 0;
  }

  .gad-icc__content > :first-child {
    margin-top: 0;
  }

  .gad-icc__content--above {
    margin-bottom: 3rem;
  }

  @media screen and (max-width: 749px) {
    .gad-icc__content--hide-m {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .gad-icc__content--left {
      text-align: left;
    }

    .gad-icc__content--right {
      text-align: right;
    }
  }

  /* Dos columnas */
  .gad-icc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 8rem;
    align-items: center;
  }

  .gad-icc--m-content-first .gad-icc__content {
    order: -1;
  }

  @media screen and (min-width: 750px) {
    .gad-icc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gad-icc--m-content-first .gad-icc__content {
      order: 0;
    }

    .gad-icc--d-content-first {
      column-gap: 9rem;
    }

    .gad-icc--d-content-first .gad-icc__content {
      order: -1;
    }
  }

  .gad-icc__items {
    --icon: 2.5rem;
    --icon-gap: 1.4rem;
    --title: 2.25rem;
  }

  .gad-icc__items--icon-xs {
    --icon: 1.6rem;
    --icon-gap: 1rem;
  }

  .gad-icc__items--icon-s {
    --icon: 2.3rem;
    --icon-gap: 1.25rem;
  }

  .gad-icc__items--icon-l {
    --icon: 3.5rem;
    --icon-gap: 1.5rem;
  }

  .gad-icc__items--icon-xl {
    --icon: 5rem;
    --icon-gap: 1.75rem;
  }

  .gad-icc__items--icon-xxl {
    --icon: 7rem;
    --icon-gap: 2.45rem;
  }

  .gad-icc__items--title-h5 {
    --title: 1.75rem;
  }

  .gad-icc__items--title-h4 {
    --title: 1.9rem;
  }

  .gad-icc__items--title-h2 {
    --title: 2.65rem;
  }

  @media screen and (max-width: 749px) {
    .gad-icc__items {
      --icon: 2.1rem;
      --icon-gap: 1rem;
      --title: 1.8rem;
    }

    .gad-icc__items--icon-xs {
      --icon: 1.5rem;
      --icon-gap: 0.75rem;
    }

    .gad-icc__items--icon-s {
      --icon: 1.75rem;
      --icon-gap: 0.85rem;
    }

    .gad-icc__items--icon-l {
      --icon: 3rem;
      --icon-gap: 1.3rem;
    }

    .gad-icc__items--icon-xl {
      --icon: 4.25rem;
      --icon-gap: 1.49rem;
    }

    .gad-icc__items--icon-xxl {
      --icon: 5.5rem;
      --icon-gap: 1.93rem;
    }

    .gad-icc__items--title-h5 {
      --title: 1.4rem;
    }

    .gad-icc__items--title-h4 {
      --title: 1.6rem;
    }

    .gad-icc__items--title-h2 {
      --title: 2.25rem;
    }
  }

  /* Cada ítem contiene los márgenes de su texto (un título h4 al final no se colapsa con el margen entre ítems). */
  .gad-icc__item {
    display: flow-root;
    margin-bottom: 3rem;
  }

  .gad-icc__item:last-child {
    margin-bottom: 0;
  }

  .gad-icc__items--center .gad-icc__item {
    text-align: center;
  }

  .gad-icc__items--right .gad-icc__item {
    text-align: right;
  }

  .gad-icc__items .gad-icc__item-title {
    display: flex;
    align-items: center;
    margin: 0 0 0.4em;
    font-size: var(--title);
    line-height: 1.3;
  }

  .gad-icc__items--center .gad-icc__item-title {
    justify-content: center;
  }

  .gad-icc__items--right .gad-icc__item-title {
    justify-content: flex-end;
  }

  .gad-icc__item-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--icon);
    height: var(--icon);
    margin-right: var(--icon-gap);
    font-size: var(--icon);
  }

  .gad-icc__item-text p {
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Íconos con contenido",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Volanta",
      "info": "Texto chico arriba del título. Vacío: no se muestra."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la volanta",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición",
      "options": [
        {
          "value": "grid",
          "label": "Grilla"
        },
        {
          "value": "columns",
          "label": "Dos columnas"
        }
      ],
      "default": "grid",
      "info": "Dos columnas: la lista de ítems de un lado y el contenido (bloques Título, Texto y Botón) del otro."
    },
    {
      "type": "checkbox",
      "id": "content_first_d",
      "label": "Contenido primero en desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "content_first_m",
      "label": "Contenido primero en mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Alineación del contenido",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left",
      "info": "En mobile va siempre centrado."
    },
    {
      "type": "checkbox",
      "id": "hide_content_m",
      "label": "Ocultar el contenido en mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_d",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columnas en desktop",
      "default": 3,
      "info": "Sólo en la grilla."
    },
    {
      "type": "select",
      "id": "columns_m",
      "label": "Columnas en mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "info": "Sólo en la grilla."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "center",
      "info": "Sólo en la grilla."
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de los íconos",
      "default": 56,
      "info": "Sólo en la grilla."
    },
    {
      "type": "select",
      "id": "icon_color",
      "label": "Color de los íconos",
      "options": [
        {
          "value": "accent",
          "label": "Acento"
        },
        {
          "value": "text",
          "label": "Texto"
        },
        {
          "value": "button",
          "label": "Botón"
        }
      ],
      "default": "accent"
    },
    {
      "type": "color",
      "id": "icon_custom_color",
      "label": "Color propio de los íconos",
      "info": "Pisa al color elegido arriba."
    },
    {
      "type": "header",
      "content": "Ítems en dos columnas"
    },
    {
      "type": "select",
      "id": "item_align",
      "label": "Alineación de los ítems",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "row_icon_size",
      "label": "Tamaño de los íconos",
      "options": [
        {
          "value": "xs",
          "label": "Muy chico"
        },
        {
          "value": "s",
          "label": "Chico"
        },
        {
          "value": "m",
          "label": "Mediano"
        },
        {
          "value": "l",
          "label": "Grande"
        },
        {
          "value": "xl",
          "label": "Muy grande"
        },
        {
          "value": "xxl",
          "label": "Enorme"
        }
      ],
      "default": "m"
    },
    {
      "type": "select",
      "id": "row_title_size",
      "label": "Tamaño del título de cada ítem",
      "options": [
        {
          "value": "h5",
          "label": "Muy chico"
        },
        {
          "value": "h4",
          "label": "Chico"
        },
        {
          "value": "h3",
          "label": "Mediano"
        },
        {
          "value": "h2",
          "label": "Grande"
        }
      ],
      "default": "h3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Combinación de colores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
      "info": "Pisan a la combinación de colores elegida arriba."
    },
    {
      "type": "color",
      "id": "cc_bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cc_bg_gradient",
      "label": "Degradé de fondo",
      "info": "Si cargás un degradé, reemplaza al color de fondo."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image",
      "label": "Imagen de fondo",
      "info": "Cubre todo el fondo y le gana al degradé."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image_mobile",
      "label": "Imagen de fondo en mobile",
      "info": "Vacía: usa la de desktop."
    },
    {
      "type": "color",
      "id": "cc_text",
      "label": "Texto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Relleno arriba",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Relleno abajo",
      "default": 36,
      "info": "En mobile se aplica el 75 %."
    },
    {
      "type": "header",
      "content": "Visibilidad y ancla"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Mostrar en",
      "options": [
        {
          "value": "all",
          "label": "Todos los dispositivos"
        },
        {
          "value": "mobile",
          "label": "Sólo mobile"
        },
        {
          "value": "desktop",
          "label": "Sólo desktop"
        }
      ],
      "default": "all",
      "info": "Desktop empieza en el ancho que se elige en Configuración del tema > Gadsden · Carruseles."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Nombre del ancla",
      "placeholder": "beneficios",
      "info": "Para que un botón lleve hasta acá: poné como enlace del botón #beneficios (el nombre que elegiste)."
    },
    {
      "type": "header",
      "content": "Tamaño de la letra"
    },
    {
      "type": "select",
      "id": "title_scale",
      "label": "Tamaño de los títulos",
      "options": [
        {
          "value": "70",
          "label": "70 %"
        },
        {
          "value": "80",
          "label": "80 %"
        },
        {
          "value": "90",
          "label": "90 %"
        },
        {
          "value": "100",
          "label": "Normal"
        },
        {
          "value": "110",
          "label": "110 %"
        },
        {
          "value": "125",
          "label": "125 %"
        },
        {
          "value": "150",
          "label": "150 %"
