        {
          "value": "bottom",
          "label": "Abajo de la pantalla"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "height",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Alto",
      "default": 4
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "info": "Vacío: el color de los botones."
    },
    {
      "type": "header",
      "content": "Visibilidad y ancla"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Mostrar en",
      "options": [
        {
          "value": "all",
          "label": "Todos los dispositivos"
        },
        {
          "value": "mobile",
          "label": "Sólo mobile"
        },
        {
          "value": "desktop",
          "label": "Sólo desktop"
        }
      ],
      "default": "all",
      "info": "Mobile es todo lo que mide menos de 990 px."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Nombre del ancla",
      "placeholder": "beneficios",
