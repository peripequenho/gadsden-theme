{%- comment -%}
  Barra de progreso de lectura (L01): una línea fija en el borde de la pantalla que se llena a medida
  que se baja por la página. No ocupa lugar en la página. Sin JavaScript no aparece.
{%- endcomment -%}
{%- assign s = section.settings -%}
<gad-reading-progress
  class="gad-rp gad-rp--{{ s.position }}"
  style="--rp-h: {{ s.height }}px;{% if s.color != blank %} --rp-c: {{ s.color }};{% endif %}"
  {% render 'gad-section-attrs', s: s %}
  hidden
>
  <span class="gad-rp__bar"></span>
</gad-reading-progress>

{% stylesheet %}
  .gad-rp {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 30;
    height: var(--rp-h, 4px);
    pointer-events: none;
  }

  .gad-rp--top {
    top: 0;
  }

  .gad-rp--bottom {
    bottom: 0;
  }

  .gad-rp__bar {
    display: block;
    height: 100%;
    background: var(--rp-c, rgb(var(--color-button)));
    transform: scaleX(0);
    transform-origin: left;
  }

  [dir='rtl'] .gad-rp__bar {
    transform-origin: right;
  }
{% endstylesheet %}

{% javascript %}
  class GadReadingProgress extends HTMLElement {
    connectedCallback() {
      this.hidden = false;
      this.bar = this.querySelector('.gad-rp__bar');
      this.onScroll = () => {
        if (this.raf) return;
        this.raf = requestAnimationFrame(() => {
          this.raf = 0;
          const total = document.documentElement.scrollHeight - window.innerHeight;
          this.bar.style.transform = `scaleX(${total > 0 ? Math.min(1, window.scrollY / total) : 0})`;
        });
      };
      window.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onScroll, { passive: true });
      this.onScroll();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onScroll);
    }
  }

  if (!customElements.get('gad-reading-progress')) customElements.define('gad-reading-progress', GadReadingProgress);
{% endjavascript %}

{% schema %}
{
  "name": "Progreso de lectura",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Una línea fija que se llena a medida que se baja por la página. No ocupa lugar."
