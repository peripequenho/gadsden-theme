{%- comment -%}
  Cierre con resaltador y escala (L15): imagen del producto, titular con una palabra resaltada cuyo
  resaltador cambia de color al aparecer, una escala "de → a" opcional, tres ítems y un botón.
  Con "reducir movimiento" el color cambia con un fundido.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign title = s.heading | escape
  if s.mark != blank
    assign mark_esc = s.mark | escape
    assign mark_html = '<mark class="gad-cl__mark">' | append: mark_esc | append: '</mark>'
    assign title = title | replace_first: mark_esc, mark_html
  endif
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<gad-closing
  class="gad-cl gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --cl-from: {{ s.mark_from }}; --cl-to: {{ s.mark_to }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width gad-cl__grid">
    <div class="gad-cl__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: s.image.alt, sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1200' }}
      {%- else -%}
        {{ 'product-2' | placeholder_svg_tag: 'gad-cl__ph' }}
      {%- endif -%}
      {%- if s.caption != blank -%}<p class="gad-cl__caption">{{ s.caption | escape }}</p>{%- endif -%}
    </div>
    <div class="gad-cl__info">
      <h2 class="gad-cl__title {{ s.heading_size }}">{{ title }}</h2>
      {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.scale_from != blank and s.scale_to != blank -%}
        <div class="gad-cl__scale" role="img" aria-label="{{ s.scale_from | escape }} → {{ s.scale_to | escape }}">
          <span class="gad-cl__bar"></span>
          <span class="gad-cl__ends"><span>{{ s.scale_from | escape }}</span><span>{{ s.scale_to | escape }}</span></span>
        </div>
      {%- endif -%}
      <ul class="gad-cl__items list-unstyled" role="list">
        {%- for i in (1..3) -%}
          {%- assign k = 'item_' | append: i -%}
          {%- if s[k] != blank -%}<li>{%- render 'gad-icon', name: 'check_circle', filled: true -%}<span>{{ s[k] }}</span></li>{%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: '#oferta' }}" class="button gad-cl__btn">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</gad-closing>

{% stylesheet %}
  gad-closing {
    display: block;
  }

  .gad-cl__grid {
    display: grid;
    gap: 2.8rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .gad-cl__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .gad-cl__media img,
  .gad-cl__ph {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.2rem;
  }

  .gad-cl__ph {
    aspect-ratio: 1;
    background: rgba(var(--color-foreground), 0.06);
  }

  .gad-cl__caption {
    margin: 0.8rem 0 0;
    font-size: 1.3rem;
    text-align: center;
    opacity: 0.75;
  }

  .gad-cl__info {
    display: grid;
    gap: 1.6rem;
  }

  .gad-cl__title {
    margin: 0;
  }

  .gad-cl__mark {
    padding: 0.1em 0.2em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background: linear-gradient(var(--cl-from), var(--cl-from)) left / 100% 100% no-repeat;
    color: inherit;
  }

  gad-closing.is-in .gad-cl__mark {
    background: linear-gradient(var(--cl-to), var(--cl-to)) left / 100% 100% no-repeat;
    animation: gadClSweep 0.9s ease both;
  }

  @keyframes gadClSweep {
    from {
      background-size: 0% 100%;
    }
  }

  html.gad-reduce gad-closing.is-in .gad-cl__mark {
    animation: none;
    transition: background 0.6s;
  }

  .gad-cl__scale {
    display: grid;
    gap: 0.6rem;
  }

  .gad-cl__bar {
    height: 1.2rem;
    border-radius: 99rem;
    background: linear-gradient(90deg, var(--cl-from), var(--cl-to));
  }

  .gad-cl__ends {
    display: flex;
    justify-content: space-between;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .gad-cl__items {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .gad-cl__items li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .gad-cl__items .gad-icon {
    font-size: 2.2rem;
  }

  @media screen and (max-width: 749px) {
    .gad-cl__btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  class GadClosing extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        this.classList.add('is-in');
      }, { threshold: 0.5 });
      io.observe(this.querySelector('.gad-cl__title'));
    }
  }

  if (!customElements.get('gad-closing')) customElements.define('gad-closing', GadClosing);
{% endjavascript %}

